# Copy to .env and fill in. .env is gitignored.

# Vipps Login client id (public). Login is Vipps only.
EXPO_PUBLIC_VIPPS_CLIENT_ID=

# --- Bundled into the app (safe to be public) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Server / CLI only. NEVER imported by app code. ---
# Project Settings > Database > Connection string (Direct connection), and its password
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
# Project Settings > API > service_role / secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# supabase.com/dashboard/account/tokens  (or run `npx supabase login` instead)
SUPABASE_ACCESS_TOKEN=

# ------------------------------------------------------------------
# Map style (Søk › Vis på kart, «Område» on an oppdrag)
# Empty = the free Kartverket map. «stadia» or «maptiler» = a modern map like Apple / Google Maps.
# Both need a paid plan for MinNabo (their free plans don't allow commercial use).
# Stadia: make an account at stadiamaps.com → Manage properties → API key.
# MapTiler: make an account at maptiler.com → Account → API keys.
# When you switch it on, Personvern must also name the provider (it sees the phone's IP address).
# ------------------------------------------------------------------
EXPO_PUBLIC_MAP_PROVIDER=
EXPO_PUBLIC_MAP_KEY=
